<div class="container mt-4">
  <h2>Order Details</h2>

  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h4>Order #<%= @order.order_number %></h4>
          <span class="badge bg-<%= @order.status_badge_class %>">
            <%= @order.status_name.titleize %>
          </span>
        </div>
        <div class="card-body">
          <!-- Payment button for pending orders -->
          <% if @order.pending? %>
            <div class="alert alert-warning mb-3">
              <strong>Payment Required!</strong> This order is awaiting payment.
              <%= link_to "Pay Now", retry_payment_order_path(@order), class: "btn btn-success btn-sm ms-2" %>
            </div>
          <% end %>

          <h5>Customer Information</h5>
          <p><strong>Name:</strong> <%= @order.customer_name %></p>
          <p><strong>Email:</strong> <%= @order.customer_email %></p>
          <p><strong>Phone:</strong> <%= @order.customer_phone %></p>

          <hr>

          <h5>Delivery Address</h5>
          <p>
            <%= @order.delivery_address %><br>
            <%= @order.delivery_city %>, <%= @order.delivery_postal_code %>
          </p>

          <% if @order.customer_notes.present? %>
            <hr>
            <h5>Order Notes</h5>
            <p><%= @order.customer_notes %></p>
          <% end %>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header">
          <h5>Order Items</h5>
        </div>
        <div class="card-body">
          <table class="table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Total</th>
              </tr>
            </thead>
            <tbody>
              <% @order.order_items.each do |item| %>
                <tr>
                  <td><%= item.product_name %></td>
                  <td><%= item.quantity %></td>
                  <td class="text-end">$<%= number_with_precision(item.unit_price, precision: 2) %></td>
                  <td class="text-end">$<%= number_with_precision(item.total_price, precision: 2) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>Order Summary</h5>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <span>Subtotal:</span>
            <span>$<%= number_with_precision(@order.subtotal, precision: 2) %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>GST (5%):</span>
            <span>$<%= number_with_precision(@order.tax_gst, precision: 2) %></span>
          </div>
          <% if @order.tax_pst > 0 %>
            <div class="d-flex justify-content-between mb-2">
              <span>PST:</span>
              <span>$<%= number_with_precision(@order.tax_pst, precision: 2) %></span>
            </div>
          <% end %>
          <div class="d-flex justify-content-between mb-2">
            <span>Delivery Fee:</span>
            <span>$<%= number_with_precision(@order.delivery_fee, precision: 2) %></span>
          </div>
          <hr>
          <div class="d-flex justify-content-between mb-3">
            <strong>Total:</strong>
            <strong>$<%= number_with_precision(@order.total_amount, precision: 2) %></strong>
          </div>

          <% if @order.stripe_payment_intent_id.present? %>
            <div class="alert alert-info small">
              <strong>Payment ID:</strong><br>
              <%= @order.stripe_payment_intent_id %>
            </div>
          <% end %>

          <div class="small text-muted">
            <p class="mb-1"><strong>Ordered:</strong> <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            <% if @order.confirmed_at %>
              <p class="mb-1"><strong>Confirmed:</strong> <%= @order.confirmed_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            <% end %>
            <% if @order.shipped_at %>
              <p class="mb-1"><strong>Shipped:</strong> <%= @order.shipped_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to "← Back to Orders", orders_path, class: "btn btn-secondary" %>
  </div>
</div>