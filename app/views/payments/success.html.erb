<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card text-center">
        <div class="card-body py-5">
          <div class="mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-check-circle text-success" viewBox="0 0 16 16">
              <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
              <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
            </svg>
          </div>
          
          <h1 class="text-success mb-3">Payment Successful!</h1>
          <p class="lead mb-4">Thank you for your order!</p>
          
          <div class="card bg-light mb-4">
            <div class="card-body">
              <h5>Order Details</h5>
              <p class="mb-1"><strong>Order Number:</strong> <%= @order.order_number %></p>
              <p class="mb-1"><strong>Total Amount:</strong> $<%= number_with_precision(@order.total_amount, precision: 2) %></p>
              <p class="mb-1"><strong>Payment Status:</strong> <span class="badge bg-success">Paid</span></p>
              <p class="mb-0"><strong>Stripe Payment ID:</strong> <%= @order.stripe_payment_intent_id %></p>
            </div>
          </div>

          <p class="text-muted mb-4">
            A confirmation email has been sent to <%= @order.customer_email %>
          </p>

          <div class="d-grid gap-2 d-md-flex justify-content-md-center">
            <%= link_to "View Order Details", order_path(@order), class: "btn btn-primary" %>
            <%= link_to "Continue Shopping", products_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
