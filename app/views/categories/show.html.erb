<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="<%= categories_path %>">Categories</a></li>
      <li class="breadcrumb-item active"><%= @category.category_name %></li>
    </ol>
  </nav>

  <h2><%= @category.category_name %></h2>
  <p class="text-muted"><%= @category.category_description %></p>

  <% if @products.any? %>
    <div class="row">
      <% @products.each do |product| %>
        <div class="col-md-3 mb-4">
          <div class="card h-100">
            <% if product.image.present? %>
              <a href="<%= product_path(product) %>">
                <img src="<%= product.image %>" class="card-img-top" alt="<%= product.name %>" style="height: 150px; object-fit: cover;">
              </a>
            <% else %>
              <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                <span class="text-muted">No Image</span>
              </div>
            <% end %>
            <div class="card-body">
              <h6 class="card-title">
                <a href="<%= product_path(product) %>" class="text-decoration-none text-dark">
                  <%= product.name.truncate(40) %>
                </a>
              </h6>
              <p class="card-text">
                <strong>$<%= number_with_precision(product.current_price, precision: 2) %></strong>
              </p>
            </div>
            <div class="card-footer bg-white">
              <% if product.in_stock? %>
                <%= form_tag add_cart_path(product_id: product.id), method: :post do %>
                  <%= submit_tag "Add to Cart", class: "btn btn-primary btn-sm w-100" %>
                <% end %>
              <% else %>
                <button class="btn btn-secondary btn-sm w-100" disabled>Out of Stock</button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="d-flex justify-content-center mt-4">
      <%= paginate @products %>
    </div>
  <% else %>
    <div class="alert alert-info">
      No products in this category.
    </div>
  <% end %>
</div>
