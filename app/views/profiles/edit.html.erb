<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="<%= profile_path %>">My Profile</a></li>
      <li class="breadcrumb-item active">Edit</li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h4 class="mb-0">Edit Profile</h4>
        </div>
        <div class="card-body">
          <%= form_for @user, url: profile_path, method: :patch do |f| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <h5>Account Information</h5>
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :username, class: "form-label" %>
                <%= f.text_field :username, class: "form-control", required: true %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :phone, class: "form-label" %>
                <%= f.text_field :phone, class: "form-control" %>
              </div>
            </div>

            <hr>

            <h5>Delivery Address</h5>
            <div class="mb-3">
              <%= f.label :address, class: "form-label" %>
              <%= f.text_field :address, class: "form-control" %>
            </div>

            <div class="row">
              <div class="col-md-4 mb-3">
                <%= f.label :city, class: "form-label" %>
                <%= f.text_field :city, class: "form-control" %>
              </div>
              <div class="col-md-4 mb-3">
                <%= f.label :province_id, "Province", class: "form-label" %>
                <%= f.collection_select :province_id, @provinces, :id, :name, { include_blank: "Select Province" }, { class: "form-select" } %>
              </div>
              <div class="col-md-4 mb-3">
                <%= f.label :postal_code, class: "form-label" %>
                <%= f.text_field :postal_code, class: "form-control" %>
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to "Cancel", profile_path, class: "btn btn-outline-secondary" %>
              <%= f.submit "Save Changes", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="card mt-4">
        <div class="card-header">
          <h5 class="mb-0">Change Password</h5>
        </div>
        <div class="card-body">
          <p>To change your password, use the link below:</p>
          <%= link_to "Change Password", edit_user_registration_path, class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>
