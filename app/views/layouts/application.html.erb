<!DOCTYPE html>
<html>
  <head>
    <title>Falls Paper</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand text-white" href="/">Falls Paper</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link text-white" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="<%= products_path %>">Products</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="<%= categories_path %>">Categories</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="<%= about_path %>">About</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white" href="<%= contact_path %>">Contact</a>
            </li>
          </ul>
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link text-white" href="<%= cart_path %>">
                Cart
                <% if cart_items_count > 0 %>
                  <span class="badge bg-danger"><%= cart_items_count %></span>
                <% end %>
              </a>
            </li>
            <% if user_signed_in? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                  <%= current_user.username %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><a class="dropdown-item" href="<%= profile_path %>">My Profile</a></li>
                  <li><a class="dropdown-item" href="<%= orders_path %>">My Orders</a></li>
                  <% if current_user.admin? %>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/admin">Admin Panel</a></li>
                  <% end %>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="<%= destroy_user_session_path %>">Logout</a></li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <a class="nav-link" href="<%= new_user_session_path %>">Login</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="<%= new_user_registration_path %>">Sign Up</a>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      </div>
    <% end %>

    <% if alert %>
      <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      </div>
    <% end %>

    <main class="flex-grow-1">
      <%= yield %>
    </main>

    <footer class="bg-dark text-white py-4 mt-auto">
      <div class="container">
        <div class="row">
          <div class="col-md-4">
            <h5>Falls Paper</h5>
            <p class="text-white">Your trusted supplier for quality office paper and printing supplies.</p>
          </div>
          <div class="col-md-4">
            <h5>Quick Links</h5>
            <ul class="list-unstyled">
              <li><a href="<%= products_path %>" class="text-white text-decoration-none">Products</a></li>
              <li><a href="<%= categories_path %>" class="text-white text-decoration-none">Categories</a></li>
              <li><a href="<%= about_path %>" class="text-white text-decoration-none">About Us</a></li>
              <li><a href="<%= contact_path %>" class="text-white text-decoration-none">Contact</a></li>
            </ul>
          </div>
          <div class="col-md-4">
            <h5>Contact</h5>
            <p class="text-white">
              123 Paper Street<br>
              Winnipeg, MB R3C 1A1<br>
              (204) 555-0100
            </p>
          </div>
        </div>
        <hr class="my-3 bg-white">
        <div class="text-center text-white">
          <p class="mb-0">Falls Paper - <%= Date.current.year %>. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
