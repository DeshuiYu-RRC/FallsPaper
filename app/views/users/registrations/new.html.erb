<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h4 class="mb-0">Create Account</h4>
        </div>
        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "users/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :username, class: "form-label" %>
              <%= f.text_field :username, autofocus: true, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control", required: true %>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :password, class: "form-label" %>
                <%= f.password_field :password, class: "form-control", required: true %>
                <small class="text-muted"><%= @minimum_password_length %> characters minimum</small>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :password_confirmation, class: "form-label" %>
                <%= f.password_field :password_confirmation, class: "form-control", required: true %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :phone, class: "form-label" %>
              <%= f.text_field :phone, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :address, class: "form-label" %>
              <%= f.text_field :address, class: "form-control" %>
            </div>

            <div class="row">
              <div class="col-md-4 mb-3">
                <%= f.label :city, class: "form-label" %>
                <%= f.text_field :city, class: "form-control" %>
              </div>
              <div class="col-md-4 mb-3">
                <%= f.label :province_id, "Province", class: "form-label" %>
                <%= f.collection_select :province_id, Province.order(:name), :id, :name, { include_blank: "Select Province" }, { class: "form-select" } %>
              </div>
              <div class="col-md-4 mb-3">
                <%= f.label :postal_code, class: "form-label" %>
                <%= f.text_field :postal_code, class: "form-control" %>
              </div>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "Create Account", class: "btn btn-primary" %>
            </div>
          <% end %>

          <hr>

          <div class="text-center">
            <p class="mb-0">Already have an account? <%= link_to "Login", new_session_path(resource_name) %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
