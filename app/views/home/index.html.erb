<div class="container mt-4">
  <div class="p-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-5">
      <h1 class="display-5 fw-bold">Welcome to Falls Paper</h1>
      <p class="col-md-8 fs-4">Your one-stop shop for thermal paper, copy paper, toner cartridges, and more office supplies.</p>
      <a class="btn btn-primary btn-lg" href="<%= products_path %>">Shop Now</a>
    </div>
  </div>

  <h2 class="mb-4">Categories</h2>
  <div class="row mb-5">
    <% @categories.each do |category| %>
      <div class="col-md-3 mb-3">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= category.category_name %></h5>
            <p class="card-text text-muted"><%= category.category_description.to_s.truncate(80) %></p>
          </div>
          <div class="card-footer bg-white">
            <%= link_to "Browse #{category.products.count} products", products_path(category_id: category.id), class: "btn btn-outline-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <h2 class="mb-4">Featured Products</h2>
  <div class="row">
    <% @featured_products.each do |product| %>
      <div class="col-md-3 mb-4">
        <div class="card h-100">
          <% if product.on_sale? %>
            <span class="badge bg-danger position-absolute" style="top: 10px; right: 10px;">
              <%= product.discount_percentage %>% OFF
            </span>
          <% end %>
          <% if product.image.present? %>
            <a href="<%= product_path(product) %>">
              <img src="<%= product.image %>" class="card-img-top" alt="<%= product.name %>" style="height: 150px; object-fit: cover;">
            </a>
          <% else %>
            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
              <span class="text-muted">No Image</span>
            </div>
          <% end %>
          <div class="card-body">
            <h6 class="card-title">
              <a href="<%= product_path(product) %>" class="text-decoration-none text-dark">
                <%= product.name.truncate(40) %>
              </a>
            </h6>
            <p class="card-text">
              <% if product.on_sale? %>
                <span class="text-danger fw-bold">$<%= number_with_precision(product.current_price, precision: 2) %></span>
                <span class="text-muted text-decoration-line-through">$<%= number_with_precision(product.original_price, precision: 2) %></span>
              <% else %>
                <strong>$<%= number_with_precision(product.current_price, precision: 2) %></strong>
              <% end %>
            </p>
          </div>
          <div class="card-footer bg-white">
            <% if product.in_stock? %>
              <%= link_to "Add to Cart", add_cart_path(product_id: product.id), method: :post, class: "btn btn-primary btn-sm w-100" %>
            <% else %>
              <button class="btn btn-secondary btn-sm w-100" disabled>Out of Stock</button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-3">
    <%= link_to "View All Products", products_path, class: "btn btn-outline-primary" %>
  </div>
</div>
