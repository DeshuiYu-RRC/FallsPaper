<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active">Shopping Cart</li>
    </ol>
  </nav>

  <h2>Shopping Cart</h2>

  <% if @cart_items.any? %>
    <div class="row">
      <div class="col-md-8">
        <div class="card">
          <div class="card-body">
            <table class="table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Price</th>
                  <th>Quantity</th>
                  <th>Total</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% @cart_items.each do |item| %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <% if item[:product].image.present? %>
                          <img src="<%= item[:product].image %>" alt="<%= item[:product].name %>" style="width: 60px; height: 60px; object-fit: cover;" class="me-3">
                        <% end %>
                        <div>
                          <a href="<%= product_path(item[:product]) %>" class="text-decoration-none">
                            <%= item[:product].name.truncate(40) %>
                          </a>
                        </div>
                      </div>
                    </td>
                    <td>$<%= number_with_precision(item[:product].current_price, precision: 2) %></td>
                    <td>
                      <%= form_tag update_item_cart_path(product_id: item[:product].id), method: :patch, class: "d-flex align-items-center" do %>
                        <%= number_field_tag :quantity, item[:quantity], min: 1, max: item[:product].stock, class: "form-control form-control-sm", style: "width: 70px;" %>
                        <%= submit_tag "Update", class: "btn btn-sm btn-outline-secondary ms-2" %>
                      <% end %>
                    </td>
                    <td>$<%= number_with_precision(item[:total], precision: 2) %></td>
                    <td>
                      <%= form_tag remove_cart_path(product_id: item[:product].id), method: :delete, style: "display: inline;" do %>
                        <%= submit_tag "Remove", class: "btn btn-sm btn-outline-danger", data: { confirm: "Are you sure?" } %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-3 d-flex justify-content-between">
          <%= link_to "Continue Shopping", products_path, class: "btn btn-outline-primary" %>
          <%= form_tag clear_cart_path, method: :delete, style: "display: inline;" do %>
            <%= submit_tag "Clear Cart", class: "btn btn-outline-danger", data: { confirm: "Are you sure you want to clear the cart?" } %>
          <% end %>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card">
          <div class="card-header">
            <strong>Order Summary</strong>
          </div>
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
              <span>Subtotal:</span>
              <span>$<%= number_with_precision(@subtotal, precision: 2) %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Tax:</span>
              <span>Calculated at checkout</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-3">
              <strong>Subtotal:</strong>
              <strong>$<%= number_with_precision(@subtotal, precision: 2) %></strong>
            </div>
            
            <% if user_signed_in? %>
              <%= link_to "Proceed to Checkout", checkout_path, class: "btn btn-primary w-100 text-white" %>
            <% else %>
              <p class="text-muted small mb-2">Please login to checkout</p>
              <%= link_to "Login", new_user_session_path, class: "btn btn-primary w-100 mb-2" %>
              <%= link_to "Create Account", new_user_registration_path, class: "btn btn-outline-primary w-100" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info">
      Your cart is empty. <a href="<%= products_path %>">Continue shopping</a>
    </div>
  <% end %>
</div>
