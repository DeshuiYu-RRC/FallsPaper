<div class="container mt-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="<%= products_path %>">Products</a></li>
      <% if @product.products_category %>
        <li class="breadcrumb-item">
          <a href="<%= products_path(category_id: @product.products_category_id) %>">
            <%= @product.products_category.category_name %>
          </a>
        </li>
      <% end %>
      <li class="breadcrumb-item active"><%= @product.name.truncate(30) %></li>
    </ol>
  </nav>

  <div class="row">
    <!-- Product Image -->
    <div class="col-md-5">
      <% if @product.image_url(:medium).present? %>
        <img src="<%= @product.image_url(:medium) %>" class="img-fluid rounded" alt="<%= @product.name %>">
      <% else %>
        <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 400px;">
          <span class="text-muted">No Image</span>
        </div>
      <% end %>
    </div>

    <!-- Product Info -->
    <div class="col-md-7">
      <h1><%= @product.name %></h1>
      
      <p class="text-muted">
        Category: 
        <a href="<%= products_path(category_id: @product.products_category_id) %>">
          <%= @product.category_name %>
        </a>
      </p>

      <div class="mb-3">
        <% if @product.on_sale? %>
          <span class="badge bg-danger mb-2"><%= @product.discount_percentage %>% OFF</span><br>
          <span class="h3 text-danger fw-bold">$<%= number_with_precision(@product.current_price, precision: 2) %></span>
          <span class="text-muted text-decoration-line-through ms-2">$<%= number_with_precision(@product.original_price, precision: 2) %></span>
        <% else %>
          <span class="h3 fw-bold">$<%= number_with_precision(@product.current_price, precision: 2) %></span>
        <% end %>
      </div>

      <p class="mb-2">
        <strong>Bulk Price:</strong> $<%= number_with_precision(@product.bulk_price, precision: 2) %>
      </p>

      <p class="mb-2">
        <strong>Quantity:</strong> <%= @product.quantity %>
      </p>

      <p class="mb-3">
        <strong>Stock:</strong>
        <% if @product.in_stock? %>
          <span class="text-success">In Stock (<%= @product.stock %> available)</span>
        <% else %>
          <span class="text-danger">Out of Stock</span>
        <% end %>
      </p>

      <% if @product.in_stock? %>
        <%= form_tag add_cart_path(product_id: @product.id), method: :post, class: "mb-4" do %>
          <div class="row g-2 align-items-center">
            <div class="col-auto">
              <label class="col-form-label">Quantity:</label>
            </div>
            <div class="col-auto">
              <%= number_field_tag :quantity, 1, min: 1, max: @product.stock, class: "form-control", style: "width: 80px;" %>
            </div>
            <div class="col-auto">
              <%= submit_tag "Add to Cart", class: "btn btn-primary" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <button class="btn btn-secondary mb-4" disabled>Out of Stock</button>
      <% end %>

      <!-- Product Details -->
      <% if @product.products_detail %>
        <div class="card mb-4">
          <div class="card-header">
            <strong>Description</strong>
          </div>
          <div class="card-body">
            <p><%= @product.products_detail.explanation %></p>
            
            <% if @product.products_detail.description_list.any? %>
              <ul>
                <% @product.products_detail.description_list.each do |item| %>
                  <li><%= item %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        </div>

        <% if @product.products_detail.specification_hash.any? %>
          <div class="card mb-4">
            <div class="card-header">
              <strong>Specifications</strong>
            </div>
            <div class="card-body">
              <table class="table table-striped mb-0">
                <tbody>
                  <% @product.products_detail.specification_hash.each do |key, value| %>
                    <tr>
                      <th style="width: 40%;"><%= key %></th>
                      <td><%= value %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Related Products -->
  <% if @related_products.any? %>
    <div class="mt-5">
      <h3>Related Products</h3>
      <div class="row">
        <% @related_products.each do |product| %>
          <div class="col-md-3 mb-4">
            <div class="card h-100 product-card">
              <% if product.on_sale? %>
                <span class="badge bg-danger position-absolute" style="top: 10px; right: 10px; z-index: 1;">
                  <%= product.discount_percentage %>% OFF
                </span>
              <% end %>
              
              <% if product.image_url(:small).present? %>
                <a href="<%= product_path(product) %>">
                  <img src="<%= product.image_url(:small) %>" class="card-img-top" alt="<%= product.name %>" style="height: 150px; object-fit: cover;">
                </a>
              <% else %>
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                  <span class="text-muted">No Image</span>
                </div>
              <% end %>
              
              <div class="card-body">
                <h6 class="card-title">
                  <a href="<%= product_path(product) %>" class="text-decoration-none text-dark">
                    <%= product.name.truncate(50) %>
                  </a>
                </h6>
                <p class="card-text text-muted small"><%= product.category_name %></p>
                <p class="card-text">
                  <% if product.on_sale? %>
                    <span class="text-danger fw-bold">$<%= number_with_precision(product.current_price, precision: 2) %></span>
                    <span class="text-muted text-decoration-line-through ms-2">$<%= number_with_precision(product.original_price, precision: 2) %></span>
                  <% else %>
                    <span class="fw-bold">$<%= number_with_precision(product.current_price, precision: 2) %></span>
                  <% end %>
                </p>
              </div>
              
              <div class="card-footer bg-white">
                <% if product.in_stock? %>
                  <%= form_tag add_cart_path(product_id: product.id), method: :post do %>
                    <%= submit_tag "Add to Cart", class: "btn btn-success btn-sm w-100" %>
                  <% end %>
                <% else %>
                  <button class="btn btn-secondary btn-sm w-100" disabled>Out of Stock</button>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
